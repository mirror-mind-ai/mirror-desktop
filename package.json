{
  "name": "mirror-desktop",
  "version": "0.2.0-alpha.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "alpha:preflight": "node scripts/private_alpha_preflight.mjs",
    "release:candidate": "node scripts/release_candidate.mjs",
    "import:mirror": "node scripts/mirror_desktop_channel.mjs import-user",
    "import:mirror:dev": "node scripts/mirror_desktop_channel.mjs import-dev",
    "validate:desktop:launch": "node scripts/mirror_desktop_channel.mjs validate-desktop",
    "test": "vitest run",
    "tauri": "tauri",
    "tauri:dev": "node scripts/mirror_desktop_channel.mjs dev",
    "tauri:user": "node scripts/mirror_desktop_channel.mjs user",
    "tauri:build:dev": "node scripts/mirror_desktop_channel.mjs build-dev",
    "tauri:build:user": "node scripts/mirror_desktop_channel.mjs build-user",
    "promote:production": "node scripts/promote_production.mjs",
    "self-update:preflight": "node scripts/self_update_preflight.mjs --config src-tauri/tauri.self-update.test.conf.json",
    "release:notes": "node scripts/release_notes.mjs",
    "release:private-update": "node scripts/private_update_publish.mjs",
    "alpha:channel:check": "node scripts/self_update_preflight.mjs --config src-tauri/tauri.alpha-update.conf.json",
    "alpha:build": "node scripts/alpha_build.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "vitest": "^3.2.0"
  }
}
