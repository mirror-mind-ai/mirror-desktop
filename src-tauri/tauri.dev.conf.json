{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nautilus for Mirror Dev",
  "identifier": "ai.mirrormind.nautilus.dev",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Nautilus for Mirror Dev",
        "width": 1100,
        "height": 760,
        "minWidth": 860,
        "minHeight": 620,
        "visible": false
      }
    ]
  },
  "bundle": {
    "icon": [
      "icons/dev/icon.png",
      "icons/dev/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/dev/icon.ico"
      }
    },
    "macOS": {
      "bundleName": "Nautilus Dev"
    }
  }
}
