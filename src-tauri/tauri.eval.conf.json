{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mirror Desktop TS Eval",
  "identifier": "ai.mirrormind.desktop.ts",
  "build": {
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Mirror Desktop TS Eval",
        "width": 1100,
        "height": 760,
        "minWidth": 860,
        "minHeight": 620,
        "visible": false
      }
    ]
  },
  "bundle": {
    "targets": ["app"],
    "createUpdaterArtifacts": false,
    "icon": ["icons/eval/icon.png"]
  }
}
