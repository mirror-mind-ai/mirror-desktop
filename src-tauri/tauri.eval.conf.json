{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nautilus for Mirror Eval",
  "identifier": "ai.mirrormind.nautilus",
  "build": {
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Nautilus for Mirror Eval",
        "width": 1100,
        "height": 760,
        "minWidth": 860,
        "minHeight": 620,
        "visible": false
      }
    ]
  },
  "bundle": {
    "targets": [
      "app"
    ],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/eval/icon.png"
    ],
    "macOS": {
      "bundleName": "Nautilus Eval"
    }
  }
}
