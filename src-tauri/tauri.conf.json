{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mirror Desktop TS",
  "version": "0.3.0-alpha.0",
  "identifier": "ai.mirrormind.desktop.ts",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mirror Desktop TS",
        "width": 1100,
        "height": 760,
        "minWidth": 860,
        "minHeight": 620,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "resources": {
      "../scripts/provision_mirror_conversation.py": "scripts/provision_mirror_conversation.py",
      "../scripts/mirror_conversation_catalog.py": "scripts/mirror_conversation_catalog.py"
    }
  }
}
